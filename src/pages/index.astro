          <figure class="group overflow-hidden"><img src="/images/rizal-monument-grounds.jpg" alt={`Malawak na tanawin ng ${entity.fullName} at bakuran ng ${entity.shortName}`} class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" loading="lazy" /></figure>
