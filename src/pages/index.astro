    <meta name="description" content={`Libreng pasok sa ${entity.fullName} sa ${entity.shortName}, ${entity.city}: oras ng pagbubukas, ruta mula LRT-1 at NAIA, mapa, panahon ngayon, at kasaysayan ng monumento. Planuhin ang pagdalaw dito.`} />
    <title>{`${entity.fullName} sa ${entity.shortName}: Oras, Ruta at Kasaysayan | Gabay Luneta`}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" hreflang="fil-PH" href={siteUrl} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
