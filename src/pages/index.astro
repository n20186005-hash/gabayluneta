/* ---------- Panahon ---------- */
/* Kinukuha sa server (build / render time) mula sa Open-Meteo at naka-cache ng 15 minuto. */
const weatherApiUrl =
  'https://api.open-meteo.com/v1/forecast' +
  '?latitude=14.5818&longitude=120.977' +
  '&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m' +
  '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max' +
  '&timezone=Asia%2FManila&forecast_days=7';

interface WeatherCurrent {
  temperature_2m: number;
  relative_humidity_2m: number;
  apparent_temperature: number;
  is_day: number;
  precipitation: number;
  weather_code: number;
  wind_speed_10m: number;
}

interface WeatherDaily {
  time: string[];
  weather_code: number[];
  temperature_2m_max: number[];
  temperature_2m_min: number[];
  precipitation_probability_max?: number[];
}

interface WeatherPayload {
  current?: WeatherCurrent;
  daily?: WeatherDaily;
}

const weatherCodeText: Record<number, string> = {
  0: 'Maliwanag',
  1: 'Halos maliwanag',
  2: 'Bahagyang maulap',
  3: 'Maulap',
  45: 'Makapal na hamog',
  48: 'Makapal na hamog',
  51: 'Magaang ambon',
  53: 'Ambon',
  55: 'Makapal na ambon',
  56: 'Malamig na ambon',
  57: 'Makapal na ambon',
  61: 'Magaang ulan',
  63: 'Ulan',
  65: 'Malakas na ulan',
  66: 'Malamig na ulan',
  67: 'Malakas na ulan',
  80: 'Magaang pag-ulan',
  81: 'Pag-ulan',
  82: 'Malakas na pag-ulan',
  85: 'Pag-ulan',
  86: 'Malakas na pag-ulan',
  95: 'Pagkulog at pagkidlat',
  96: 'Kulog at malakas na ulan',
  99: 'Kulog at malakas na ulan'
};

function describeWeatherCode(code: number) {
  return weatherCodeText[code] || 'Hindi tiyak ang lagay';
}

let weatherCachePayload: WeatherPayload | null = null;
let weatherCacheStamp = 0;
const WEATHER_CACHE_MS = 15 * 60 * 1000;

async function loadWeather() {
  if (weatherCachePayload && Date.now() - weatherCacheStamp < WEATHER_CACHE_MS) return weatherCachePayload;
  try {
    const response = await fetch(weatherApiUrl);
    if (!response.ok) return null;
    const payload = (await response.json()) as WeatherPayload;
    weatherCachePayload = payload;
    weatherCacheStamp = Date.now();
    return payload;
  } catch (error) {
    return null;
  }
}

const weatherRaw = await loadWeather();

const weekdayFormatter = new Intl.DateTimeFormat('fil-PH', { timeZone: 'Asia/Manila', weekday: 'short' });
const dayDateFormatter = new Intl.DateTimeFormat('fil-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric' });
const stampFormatter = new Intl.DateTimeFormat('fil-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium', timeStyle: 'short' });

const weatherDays = weatherRaw && weatherRaw.daily && Array.isArray(weatherRaw.daily.time)
  ? weatherRaw.daily.time.map(function (day, index) {
      const dayDate = new Date(day + 'T00:00:00+08:00');
      const probability = weatherRaw.daily.precipitation_probability_max
        ? weatherRaw.daily.precipitation_probability_max[index]
        : null;
      return {
        weekday: weekdayFormatter.format(dayDate),
        date: dayDateFormatter.format(dayDate),
        max: Math.round(weatherRaw.daily.temperature_2m_max[index]),
        min: Math.round(weatherRaw.daily.temperature_2m_min[index]),
        probability: probability,
        text: describeWeatherCode(weatherRaw.daily.weather_code[index]),
        umbrella: probability !== null && probability >= 50
      };
    })
  : [];

const weatherNow = weatherRaw && weatherRaw.current
  ? {
      hasData: true,
      temp: Math.round(weatherRaw.current.temperature_2m),
      feels: Math.round(weatherRaw.current.apparent_temperature),
      humidity: Math.round(weatherRaw.current.relative_humidity_2m),
      wind: Math.round(weatherRaw.current.wind_speed_10m),
      rain: Number(weatherRaw.current.precipitation).toFixed(1),
      text: describeWeatherCode(weatherRaw.current.weather_code)
    }
  : { hasData: false, temp: '—', feels: '—', humidity: '—', wind: '—', rain: '—', text: 'Hindi pa available' };

const todayProbability = weatherDays.length ? weatherDays[0].probability : null;
const umbrellaAdvice =
  todayProbability === null
    ? 'Suriin ang pinakabagong ulat bago lumabas; madalas ang biglaang pag-ulan sa hapon.'
    : todayProbability >= 50
      ? 'Magdala ng payong — may ' + todayProbability + '% na tsansa ng ulan ngayon.'
      : 'Mababa ang tsansa ng ulan (' + todayProbability + '%). Payong ay opsyonal; tubig at lilim ang mahalaga.';
const weatherStampLabel = stampFormatter.format(new Date());

const weatherDayCards = weatherDays.map(function (day) {
  return Object.assign({}, day, {
    rainLabel:
      (day.umbrella ? 'Magdala ng payong' : 'Payong: opsyonal') +
      (day.probability !== null ? ' · ' + day.probability + '% ulan' : '')
  });
});

