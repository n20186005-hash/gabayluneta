  'Dalhin ang sariling basura hanggang sa makakita ng tamang tapunan; iwan ang pampublikong espasyo nang mas maayos kaysa sa pagdating mo.',
  'Huwag magpakain o manggulo sa mga hayop sa parke, at iwasan ang paglapit nang labis sa mga puno at halaman.',
  'Bawasan ang ingay at ilayo ang malalakas na speaker; maraming bisita ang pumupunta para sa tahimik na paggunita.',
  'Suriin ang kasalukuyang patakaran ng NPDC para sa drone, tripod, at komersyal na pagkuha ng larawan bago magtungo.'
];

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: entity.fullName,
  alternateName: [
    entity.shortName,
    entity.officialEnglishName,
    `${entity.city} ${entity.fullName}`,
    'Motto Stella'
  ],
  additionalType: 'https://schema.org/LandmarksOrHistoricalBuildings',
  description: `Komprehensibong gabay-pasyal sa ${entity.fullName} sa ${entity.shortName}, ${entity.city}, ${entity.region}, ${entity.country}: kasaysayan, kronolohiya, oras ng pagbubukas, panahon, ruta, transportasyon, at mga kalapit na pasyalan.`,
  inLanguage: 'fil',
  url: siteUrl,
  image: [heroImageUrl],
  photo: [
    { '@type': 'ImageObject', url: heroImageUrl, caption: `${entity.fullName} — harapang tanawin ng granite at bronze sa ${entity.shortName}`, creditText: 'National Parks Development Committee (NPDC)', license: entity.govtTourismUrl },
    { '@type': 'ImageObject', url: `${siteUrl}/images/rizal-monument-flags.jpg`, caption: `${entity.fullName} — napapalibutan ng mga watawat ng Pilipinas`, creditText: 'National Parks Development Committee (NPDC)', license: entity.govtTourismUrl },
    { '@type': 'ImageObject', url: `${siteUrl}/images/rizal-monument-sunset.jpg`, caption: `${entity.fullName} — huling liwanag ng hapon sa ${entity.shortName}`, creditText: 'National Parks Development Committee (NPDC)', license: entity.govtTourismUrl },
    { '@type': 'ImageObject', url: `${siteUrl}/images/rizal-monument-garden.jpg`, caption: `Mga hardin at bakuran ng ${entity.parkName}`, creditText: 'National Parks Development Committee (NPDC)', license: entity.govtTourismUrl }
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: [
    'Pamilya na may bata',
    'Potograpiya at kalikasan',
    'Kasaysayan at heritage walk',
    'Mababang lakas / accessible na ruta'
  ],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Libreng pasok sa monumento at bakuran', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Patag at sementadong daanan para sa wheelchair at stroller', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Lilim, bangko at lawn bilang pahingahan', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Pampublikong banyo sa loob at paligid ng parke', value: 'Maaaring may maliit na bayad; nag-iiba ang oras ng serbisyo' }
  ],
  containedInPlace: {
    '@type': 'TouristAttraction',
    name: entity.parkName,
    url: 'https://npdc.gov.ph/rizal-park/'
  },
  hasMap: entity.mapsShareUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: entity.streetAddress,
    addressLocality: entity.city,
    addressRegion: entity.region,
    postalCode: entity.postalCode,
    addressCountry: entity.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: entity.latitude,
    longitude: entity.longitude
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'https://schema.org/Monday',
        'https://schema.org/Tuesday',
        'https://schema.org/Wednesday',
        'https://schema.org/Thursday',
        'https://schema.org/Friday',
        'https://schema.org/Saturday',
        'https://schema.org/Sunday'
      ],
      opens: '05:00',
      closes: '22:00'
    }
  ],
  sameAs: [
    entity.mapsShareUrl,
    entity.govtTourismUrl,
    'https://philhistoricsites.nhcp.gov.ph/registry_database/jose-rizal-national-monument-1913/'
  ]
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Gabay Luneta', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: entity.fullName, item: `${siteUrl}/#attraction` }
  ]
};

/* Non-profit publisher at website entity — para sa mas malinaw na pinagmumulan ng impormasyon. */
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Gabay Luneta',
      description: `Independente at hindi kumikitang gabay-pasyal para sa ${entity.fullName} sa ${entity.city}, ${entity.country}. Hindi ito opisyal na website ng NPDC, NHCP, o ng Pamahalaan ng Pilipinas.`,
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/logo.svg`
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Gabay Luneta',
      inLanguage: 'fil',
      publisher: { '@id': `${siteUrl}/#organization` },
      about: { '@id': `${siteUrl}/#attraction` }
    }
  ]
};

/* Ang rating at mga review ay IPINAPAKITA LAMANG SA PAHINA — hindi isinasama sa JSON-LD. */
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
