---
import '../styles/global.css';

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = Astro.site ? new URL('/og-image.jpg', Astro.site).toString() : '/og-image.jpg';
const mapUrl = 'https://www.google.com/maps?q=14.5817917,120.9770458&z=17&output=embed&hl=fil&gl=PH';

const faqItems = [
  {
    question: 'May entrance fee ba sa Bantayog ni José Rizal?',
    answer: 'Karaniwang libre ang pagpasok sa Rizal Park at walang hiwalay na bayad para makita ang monumento. Maaaring may sariling singil o patakaran ang ilang espesyal na aktibidad o pasilidad sa paligid.'
  },
  {
    question: 'Anong oras magandang pumunta?',
    answer: 'Pinakakomportable ang maagang umaga o huling bahagi ng hapon, kapag mas banayad ang init at mas maganda ang liwanag para sa mga larawan. Bukas ang Rizal Park araw-araw, kabilang ang mga public holiday, mula 5:00 AM hanggang 10:00 PM ayon sa NPDC.'
  },
  {
    question: 'Gaano katagal ang dapat ilaan?',
    answer: 'Maglaan ng humigit-kumulang 45–90 minuto para sa monumento, mga hardin, at maikling paglalakad sa Luneta. Kung isasama ang National Museum complex o Intramuros, mas mainam ang kalahating araw.'
  },
  {
    question: 'Ano ang pinakamalapit na LRT?',
    answer: 'Praktikal na babaan ang United Nations Avenue station ng LRT-1 sa Taft Avenue. Mula roon, maglakad patungong kanluran sa direksiyon ng Rizal Park at Roxas Boulevard, o sumakay ng maikling jeepney/taxi kung kailangan.'
  },
  {
    question: 'May paradahan ba sa mismong monumento?',
    answer: 'Walang maluwang na dedicated visitor parking sa mismong paanan ng monumento. Mas praktikal ang mga paid parking area sa paligid ng Luneta, Quirino Grandstand, mga kalapit na hotel, o mall; nagbabago ang availability lalo na kapag may event.'
  },
  {
    question: 'Pwede bang kumuha ng litrato?',
    answer: 'Oo para sa karaniwang personal na pagkuha ng larawan sa pampublikong bahagi ng parke. Igalang ang mga nakatalagang guwardiya, ceremonial areas, pansamantalang harang, at anumang kasalukuyang abiso ng NPDC.'
  }
];

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Bantayog ni José Rizal',
  alternateName: ['Rizal Monument', 'Motto Stella'],
  description: 'Ang pambansang bantayog at himlayan ni Dr. José Rizal sa Rizal Park, Luneta, Maynila.',
  ...(canonicalUrl ? { url: canonicalUrl, image: [new URL('/images/rizal-monument-front.jpg', Astro.site!).toString()] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1225 Roxas Boulevard, Ermita',
    addressLocality: 'Manila',
    addressRegion: 'Metro Manila',
    postalCode: '1000',
    addressCountry: 'PH'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 14.5817917,
    longitude: 120.9770458
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'https://schema.org/Monday',
        'https://schema.org/Tuesday',
        'https://schema.org/Wednesday',
        'https://schema.org/Thursday',
        'https://schema.org/Friday',
        'https://schema.org/Saturday',
        'https://schema.org/Sunday'
      ],
      opens: '05:00',
      closes: '22:00'
    }
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.6,
    bestRating: 5,
    ratingCount: 233
  },
  isAccessibleForFree: true,
  sameAs: ['https://npdc.gov.ph/rizal-monument/']
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<!doctype html>
<html lang="fil">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#10263a" />
    <meta name="description" content="Gabay sa pagbisita sa Bantayog ni José Rizal sa Luneta, Maynila — kasaysayan, oras, pamasahe, parking, pagkain, mapa at mga kalapit na pasyalan." />
    <title>Bantayog ni José Rizal | Gabay sa Luneta, Maynila</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fil_PH" />
    <meta property="og:title" content="Bantayog ni José Rizal | Gabay sa Luneta" />
    <meta property="og:description" content="Isang malinaw at makasaysayang gabay sa pagbisita sa Motto Stella sa puso ng Luneta." />
    <meta property="og:image" content={ogImageUrl} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="paper-noise overflow-x-hidden">
    <header class="absolute inset-x-0 top-0 z-50 border-b border-white/15 text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 lg:px-8">
        <a href="#itaas" aria-label="Bantayog ni José Rizal — bumalik sa itaas" class="shrink-0 rounded-sm bg-paper/95 px-3 py-2 shadow-lg shadow-black/10">
          <img src="/logo.svg" width="270" height="45" alt="Motto Stella — Bantayog ni José Rizal" class="h-9 w-auto sm:h-10" />
        </a>
        <nav aria-label="Pangunahing nabigasyon" class="hidden items-center gap-7 text-[11px] font-semibold uppercase tracking-[0.18em] md:flex">
          <a class="transition hover:text-gold" href="#kuwento">Kuwento</a>
          <a class="transition hover:text-gold" href="#dalaw">Pagdalaw</a>
          <a class="transition hover:text-gold" href="#pagpunta">Pagpunta</a>
          <a class="transition hover:text-gold" href="#paligid">Paligid</a>
          <a class="transition hover:text-gold" href="#faq">FAQ</a>
        </nav>
      </div>
    </header>

    <main id="itaas">
      <section class="relative min-h-[92vh] overflow-hidden bg-ink text-white">
        <img src="/images/rizal-monument-flags.jpg" alt="Bantayog ni José Rizal na napapalibutan ng mga watawat ng Pilipinas sa Luneta" class="absolute inset-0 h-full w-full object-cover object-[center_42%] opacity-55" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,23,36,.93)_0%,rgba(7,23,36,.74)_43%,rgba(7,23,36,.22)_78%,rgba(7,23,36,.46)_100%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-ink to-transparent"></div>
        <div class="relative mx-auto flex min-h-[92vh] max-w-7xl items-end px-5 pb-16 pt-32 lg:px-8 lg:pb-20">
          <div class="max-w-3xl reveal">
            <div class="mb-7 flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.3em] text-gold">
              <span class="h-px w-12 bg-gold"></span>
              Motto Stella · Luneta, Maynila
            </div>
            <h1 class="display text-5xl font-normal leading-[.98] tracking-[-.045em] sm:text-7xl lg:text-[6.6rem]">Bantayog ni<br /><em class="font-normal text-paper">José Rizal</em></h1>
            <p class="mt-7 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">Isang himlayan, isang pambansang alaala, at isang “gumagabay na bituin” sa bukana ng Maynila. Kilalanin muna ang mga simbolo nito bago tumayo sa harap ng bantayog.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#dalaw" class="rounded-full bg-gold px-6 py-3 text-sm font-bold text-ink transition hover:-translate-y-0.5 hover:bg-[#dab45c]">Planuhin ang pagdalaw</a>
              <a href="#mapa" class="rounded-full border border-white/35 bg-white/5 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/12">Tingnan ang mapa</a>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Mabilis na impormasyon" class="relative z-10 -mt-1 bg-ink pb-10 text-white">
        <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-white/15 px-5 sm:grid-cols-4 lg:px-8">
          <div class="bg-ink px-5 py-6"><p class="text-[10px] uppercase tracking-[.2em] text-gold">Oras ng parke</p><p class="display mt-2 text-xl">5:00 AM–10:00 PM</p><p class="mt-1 text-xs text-white/55">araw-araw</p></div>
          <div class="bg-ink px-5 py-6"><p class="text-[10px] uppercase tracking-[.2em] text-gold">Pangkalahatang pasok</p><p class="display mt-2 text-xl">Karaniwang libre</p><p class="mt-1 text-xs text-white/55">walang hiwalay na ticket sa monumento</p></div>
          <div class="bg-ink px-5 py-6"><p class="text-[10px] uppercase tracking-[.2em] text-gold">Rating</p><p class="display mt-2 text-xl">4.6 / 5</p><p class="mt-1 text-xs text-white/55">Tripadvisor rating na ginamit sa schema</p></div>
          <div class="bg-ink px-5 py-6"><p class="text-[10px] uppercase tracking-[.2em] text-gold">Ilaan</p><p class="display mt-2 text-xl">45–90 minuto</p><p class="mt-1 text-xs text-white/55">para sa monumento at paligid</p></div>
        </div>
      </section>

      <section id="kuwento" class="relative overflow-hidden py-20 sm:py-28">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:px-8">
          <div class="starburst relative mx-auto w-full max-w-lg">
            <figure class="relative z-10 overflow-hidden rounded-t-[12rem] border border-ink/10 bg-stone shadow-2xl shadow-ink/15">
              <img src="/images/rizal-monument-front.jpg" alt="Harapang tanawin ng granite at bronze na Bantayog ni José Rizal" class="aspect-[4/5] w-full object-cover" loading="lazy" />
            </figure>
            <div class="absolute -bottom-5 -right-3 z-20 w-44 border border-gold/50 bg-paper p-4 shadow-xl sm:-right-8">
              <p class="text-[10px] font-bold uppercase tracking-[.22em] text-rizal-red">Taas</p>
              <p class="display mt-1 text-3xl">14 metro</p>
              <p class="mt-2 text-xs leading-5 text-ink-soft">granite at bronze, ayon sa NPDC</p>
            </div>
          </div>
          <div class="lg:pl-8">
            <p class="text-xs font-bold uppercase tracking-[.24em] text-rizal-red">Ang kuwento ng Motto Stella</p>
            <h2 class="display mt-4 text-4xl leading-tight tracking-tight sm:text-5xl">Dinisenyo upang maging <em>gumagabay na bituin.</em></h2>
            <p class="mt-6 text-base leading-8 text-ink-soft">Ang monumento ay likha ng Swiss sculptor na si Dr. Richard Kissling. Tinawag itong <strong class="text-ink">Motto Stella</strong> — “guiding star.” Sa ilalim nito nakahimlay ang mga labi ni Dr. José Rizal, na inilipat sa Luneta bilang bahagi ng paglikha ng pambansang alaala sa lugar ng kanyang pagkamatay.</p>
            <p class="mt-5 text-base leading-8 text-ink-soft">Noong 1901, iniatas ng Act No. 243 ang pagtatayo ng bantayog. Isang pandaigdigang kumpetisyon sa disenyo ang sumunod; kalaunan, ang disenyo ni Kissling ang naisakatuparan. Ang monumento ay pormal na inilantad noong 1913.</p>
            <a href="https://npdc.gov.ph/rizal-monument/" target="_blank" rel="noreferrer" class="mt-7 inline-flex items-center gap-3 border-b border-gold pb-1 text-sm font-bold text-ink transition hover:text-rizal-red">Basahin ang opisyal na kasaysayan sa NPDC <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="bg-paper-deep py-20 sm:py-24">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-xs font-bold uppercase tracking-[.24em] text-rizal-red">Basahin ang monumento</p>
            <h2 class="display mt-4 text-4xl tracking-tight sm:text-5xl">Apat na detalye na hindi dapat lampasan.</h2>
          </div>
          <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            <article class="border-t-2 border-gold bg-paper p-6"><span class="display text-4xl text-gold">I</span><h3 class="display mt-8 text-2xl">Ang libro</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Hawak ni Rizal ang aklat na kumakatawan sa <em>Noli Me Tángere</em> at <em>El Filibusterismo</em> — mga akdang naging bahagi ng kanyang pamana.</p></article>
            <article class="border-t-2 border-gold bg-paper p-6"><span class="display text-4xl text-gold">II</span><h3 class="display mt-8 text-2xl">Ang obelisk</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Ang pataas na anyo ng granite obelisk ang nagbibigay sa bantayog ng matatag at halos beacon-like na silweta sa Luneta.</p></article>
            <article class="border-t-2 border-gold bg-paper p-6"><span class="display text-4xl text-gold">III</span><h3 class="display mt-8 text-2xl">Tatlong bituin</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Ang tatlong bituin ay sumasagisag sa Luzon, Visayas, at Mindanao — isang pambansang pagbasa sa memorial.</p></article>
            <article class="border-t-2 border-gold bg-paper p-6"><span class="display text-4xl text-gold">IV</span><h3 class="display mt-8 text-2xl">Pamilya at edukasyon</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Ang mga pigurang kasama ng bantayog ay nagbibigay-diin sa pamilya at edukasyon, dalawang tema sa pagpapakahulugan ng komposisyon.</p></article>
          </div>
        </div>
      </section>

      <section aria-label="Mga larawan ng monumento" class="bg-ink py-4">
        <div class="mx-auto grid max-w-[1600px] gap-4 px-4 sm:grid-cols-2 lg:grid-cols-4">
          <figure class="group overflow-hidden"><img src="/images/rizal-monument-garden.jpg" alt="Rizal Monument mula sa luntiang bahagi ng parke" class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" loading="lazy" /></figure>
          <figure class="group overflow-hidden sm:row-span-2 lg:row-span-1"><img src="/images/rizal-monument-sunset.jpg" alt="Rizal Monument sa mainit na liwanag ng hapon" class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" loading="lazy" /></figure>
          <figure class="group overflow-hidden"><img src="/images/rizal-monument-grounds.jpg" alt="Malawak na tanawin ng monumento at bakuran ng Luneta" class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" loading="lazy" /></figure>
          <figure class="group overflow-hidden"><img src="/images/rizal-monument-flags.jpg" alt="Mga watawat ng Pilipinas sa paligid ng Rizal Monument" class="aspect-[4/3] h-full w-full object-cover object-[center_42%] transition duration-500 group-hover:scale-[1.025]" loading="lazy" /></figure>
        </div>
        <p class="mx-auto max-w-7xl px-5 pb-3 pt-4 text-[10px] tracking-wide text-white/45 lg:px-8">Mga larawan: National Parks Development Committee. Public domain maliban kung may ibang pahayag sa pinagmulan.</p>
      </section>

      <section id="dalaw" class="py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.24em] text-rizal-red">Praktikal na gabay</p>
              <h2 class="display mt-4 text-4xl tracking-tight sm:text-5xl">Bago ka pumunta.</h2>
              <p class="mt-5 max-w-md text-sm leading-7 text-ink-soft">Ang monumento ay nasa bukas na bahagi ng Luneta, kaya mas nakakaapekto ang araw, ulan, public events, at crowd level kaysa sa isang tipikal na indoor attraction.</p>
            </div>
            <div class="grid gap-px overflow-hidden border border-ink/10 bg-ink/10 sm:grid-cols-2">
              <article class="bg-paper p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-rizal-red">Pinakamagandang oras</p><h3 class="display mt-3 text-2xl">Maagang umaga o huling hapon</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Mas banayad ang init at mas maganda ang sidelight sa granite at bronze. Sa tanghali, maghanda sa init at biglaang ulan.</p></article>
              <article class="bg-paper p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-rizal-red">Tagal</p><h3 class="display mt-3 text-2xl">45–90 minuto</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Sapat para sa monumento, simbolismo, larawan, at maikling ikot. Magdagdag ng oras para sa mga museo at Intramuros.</p></article>
              <article class="bg-paper p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-rizal-red">Ticket / gastos</p><h3 class="display mt-3 text-2xl">Walang hiwalay na ticket</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Karaniwang libre ang general admission sa Rizal Park. Ang guided tour, espesyal na event, o ibang attraction ay maaaring may hiwalay na patakaran.</p></article>
              <article class="bg-paper p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-rizal-red">Dalhin</p><h3 class="display mt-3 text-2xl">Tubig, payong, respeto</h3><p class="mt-3 text-sm leading-6 text-ink-soft">Outdoor ang pangunahing karanasan. Panatilihing malinaw ang ceremonial areas at sundin ang abiso ng park staff.</p></article>
            </div>
          </div>

          <div class="mt-12 border-y border-ink/15 py-8">
            <div class="grid gap-7 md:grid-cols-[.35fr_.65fr]">
              <div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-rizal-red">Paradahan</p><h3 class="display mt-2 text-3xl">Plan B bago magmaneho.</h3></div>
              <div class="grid gap-5 sm:grid-cols-2">
                <p class="text-sm leading-7 text-ink-soft"><strong class="text-ink">Sa mismong monumento:</strong> walang malaking dedicated visitor lot sa paanan nito. Huwag umasa sa curbside parking sa Roxas Boulevard.</p>
                <p class="text-sm leading-7 text-ink-soft"><strong class="text-ink">Mas praktikal:</strong> paid parking sa paligid ng Luneta/Quirino Grandstand o sa kalapit na hotel at commercial areas. Dumating nang mas maaga kapag may malaking event dahil mabilis mapuno ang paligid.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="pagpunta" class="bg-ink py-20 text-white sm:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-2">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.24em] text-gold">Detalyadong transportasyon</p>
              <h2 class="display mt-4 text-4xl tracking-tight sm:text-5xl">Pumunta sa Luneta, hindi lang sa “1225 Roxas.”</h2>
              <p class="mt-5 max-w-xl text-sm leading-7 text-white/65">Sa navigation app, gamitin ang <strong class="text-white">“Rizal Monument”</strong> bilang destination para tumama sa memorial mismo at hindi sa isang generic na bahagi ng boulevard.</p>
            </div>
            <div class="space-y-7">
              <article class="border-l border-gold/70 pl-6"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-gold">LRT-1</p><h3 class="display mt-2 text-2xl">United Nations Avenue</h3><p class="mt-2 text-sm leading-6 text-white/65">Bumaba sa U.N. Avenue station sa Taft Avenue. Mula roon, tumuloy pakanluran sa direksiyon ng T.M. Kalaw / Rizal Park. Maaaring lakarin o paikliin sa jeepney/taxi depende sa init, ulan, o mobility needs.</p></article>
              <article class="border-l border-gold/70 pl-6"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-gold">Jeepney / bus</p><h3 class="display mt-2 text-2xl">Taft, Kalaw, Mabini at Luneta corridor</h3><p class="mt-2 text-sm leading-6 text-white/65">Pumili ng rutang dumaraan sa T.M. Kalaw, Taft Avenue, Mabini, o Rizal Park. Sabihin sa drayber na sa “Luneta” o “Rizal Monument” ka bababa. Maaaring magbago ang aktuwal na ruta dahil sa road closure o event.</p></article>
              <article class="border-l border-gold/70 pl-6"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-gold">Taxi / ride-hailing</p><h3 class="display mt-2 text-2xl">Pinakasimple para sa grupo</h3><p class="mt-2 text-sm leading-6 text-white/65">I-pin ang “Rizal Monument, Roxas Boulevard, Ermita.” Maglaan ng dagdag na oras sa rush hour; posibleng ilipat ang drop-off point kapag may programa sa Luneta.</p></article>
              <article class="border-l border-gold/70 pl-6"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-gold">Mula NAIA</p><h3 class="display mt-2 text-2xl">Diretsong taxi/ride-hailing ang pinakamadaling planuhin</h3><p class="mt-2 text-sm leading-6 text-white/65">Para sa bisitang may bagahe, mas diretso ang door-to-door ride. Kung pampublikong transportasyon, ang aktuwal na combination ay nakadepende sa terminal at kasalukuyang serbisyo, kaya tingnan ang live transit directions sa araw ng biyahe.</p></article>
            </div>
          </div>

          <div id="mapa" class="mt-14 overflow-hidden border border-white/15 bg-white/5">
            <div class="flex flex-wrap items-end justify-between gap-4 border-b border-white/15 px-5 py-5 sm:px-7">
              <div><p class="text-[10px] font-bold uppercase tracking-[.2em] text-gold">Mapa</p><h3 class="display mt-1 text-2xl">Rizal Monument · Ermita, Maynila</h3></div>
              <a href="https://maps.app.goo.gl/FoCBsLYeuxtmVA8W6" target="_blank" rel="noreferrer" class="text-xs font-bold text-gold hover:text-white">Buksan sa Google Maps ↗</a>
            </div>
            <iframe title="Mapa ng Bantayog ni José Rizal sa Maynila" src={mapUrl} class="h-[460px] w-full border-0 grayscale-[20%]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>
      </section>

      <section id="paligid" class="py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-5 lg:grid-cols-2">
            <div class="border border-ink/10 bg-paper-deep p-7 sm:p-9">
              <p class="text-xs font-bold uppercase tracking-[.24em] text-rizal-red">Kain sa paligid</p>
              <h2 class="display mt-3 text-4xl tracking-tight">Mula merienda hanggang heritage meal.</h2>
              <div class="mt-8 space-y-7">
                <article><div class="flex items-baseline justify-between gap-4"><h3 class="display text-2xl">Café Ilang-Ilang</h3><span class="text-[10px] font-bold uppercase tracking-[.15em] text-rizal-red">Manila Hotel</span></div><p class="mt-2 text-sm leading-6 text-ink-soft">Malapit na hotel buffet para sa mas mahabang pagkain; bagay kung nais mong pagsamahin ang Luneta at isang classic Manila Hotel stop.</p></article>
                <div class="fine-rule"></div>
                <article><div class="flex items-baseline justify-between gap-4"><h3 class="display text-2xl">Estoria Manila</h3><span class="text-[10px] font-bold uppercase tracking-[.15em] text-rizal-red">Ermita</span></div><p class="mt-2 text-sm leading-6 text-ink-soft">Filipino-focused café-restaurant na may Old Manila / modern Filipiniana feel sa Del Pilar Street — praktikal para manatili sa heritage mood pagkatapos ng park.</p></article>
                <div class="fine-rule"></div>
                <article><div class="flex items-baseline justify-between gap-4"><h3 class="display text-2xl">Ilustrado</h3><span class="text-[10px] font-bold uppercase tracking-[.15em] text-rizal-red">Intramuros</span></div><p class="mt-2 text-sm leading-6 text-ink-soft">Filipino-Spanish heritage dining sa Intramuros. Mas bagay bilang kasunod na stop kung itutuloy mo ang historical walk papasok sa Walled City.</p></article>
                <div class="fine-rule"></div>
                <article><div class="flex items-baseline justify-between gap-4"><h3 class="display text-2xl">Manam · SM City Manila</h3><span class="text-[10px] font-bold uppercase tracking-[.15em] text-rizal-red">Filipino comfort food</span></div><p class="mt-2 text-sm leading-6 text-ink-soft">Mas casual at group-friendly na opsyon para sa Filipino classics at modern twists kapag gusto mo ng air-conditioned meal pagkatapos maglakad.</p></article>
              </div>
              <p class="mt-8 text-xs leading-5 text-ink-soft">Tip: Ang oras, menu, at availability ng restaurant ay nagbabago. I-check ang kasalukuyang listing bago pumunta.</p>
            </div>

            <div class="border border-ink/10 bg-ink p-7 text-white sm:p-9">
              <p class="text-xs font-bold uppercase tracking-[.24em] text-gold">Kalapit na pasyalan</p>
              <h2 class="display mt-3 text-4xl tracking-tight">Gawing heritage loop ang Luneta.</h2>
              <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <article class="border border-white/15 p-5"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-gold">Museo</p><h3 class="display mt-3 text-2xl">National Museum of Anthropology</h3><p class="mt-2 text-sm leading-6 text-white/60">Nasa gilid mismo ng Rizal Park; natural na kasunod para sa kulturang Pilipino at materyal na pamana.</p></article>
                <article class="border border-white/15 p-5"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-gold">Museo</p><h3 class="display mt-3 text-2xl">National Museum of Fine Arts</h3><p class="mt-2 text-sm leading-6 text-white/60">Isang maikling lakad sa museum complex, mainam para sa sining at mas malawak na konteksto ng kasaysayan.</p></article>
                <article class="border border-white/15 p-5"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-gold">Lumang Maynila</p><h3 class="display mt-3 text-2xl">Intramuros</h3><p class="mt-2 text-sm leading-6 text-white/60">Tumawid patungo sa makasaysayang Walled City para sa mga pader, simbahan, plaza, at heritage streets.</p></article>
                <article class="border border-white/15 p-5"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-gold">Baybayin</p><h3 class="display mt-3 text-2xl">Manila Ocean Park</h3><p class="mt-2 text-sm leading-6 text-white/60">Nasa bahagi ng Manila Bay sa kanlurang dulo ng Luneta area; magandang family-oriented na karugtong ng itinerary.</p></article>
                <article class="border border-white/15 p-5 sm:col-span-2"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-gold">Sa loob ng parke</p><h3 class="display mt-3 text-2xl">Noli Me Tangere Garden · Martyrdom site · Gomburza marker</h3><p class="mt-2 text-sm leading-6 text-white/60">Bago lumabas ng Luneta, hanapin ang iba pang memorial at garden spaces na nakalista ng NPDC. Mas buo ang kuwento kapag hindi monumento lamang ang pinuntahan.</p></article>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-y border-ink/10 bg-paper-deep py-16">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 lg:grid-cols-[.45fr_.55fr] lg:px-8">
          <div><p class="text-xs font-bold uppercase tracking-[.24em] text-rizal-red">Isang payak na ruta</p><h2 class="display mt-3 text-4xl">Kung 3 oras lang ang meron ka.</h2></div>
          <ol class="grid gap-4 sm:grid-cols-3">
            <li class="border-t border-gold pt-4"><span class="text-xs font-bold text-rizal-red">01</span><p class="display mt-2 text-xl">Monumento</p><p class="mt-2 text-xs leading-5 text-ink-soft">Basahin ang mga simbolo at maglakad sa memorial grounds.</p></li>
            <li class="border-t border-gold pt-4"><span class="text-xs font-bold text-rizal-red">02</span><p class="display mt-2 text-xl">National Museum</p><p class="mt-2 text-xs leading-5 text-ink-soft">Piliin ang Anthropology o Fine Arts depende sa interes.</p></li>
            <li class="border-t border-gold pt-4"><span class="text-xs font-bold text-rizal-red">03</span><p class="display mt-2 text-xl">Intramuros</p><p class="mt-2 text-xs leading-5 text-ink-soft">Tapusin sa heritage streets at pagkain sa Walled City.</p></li>
          </ol>
        </div>
      </section>

      <section id="faq" class="py-20 sm:py-28">
        <div class="mx-auto max-w-4xl px-5 lg:px-8">
          <div class="text-center">
            <p class="text-xs font-bold uppercase tracking-[.24em] text-rizal-red">FAQ · Madalas itanong</p>
            <h2 class="display mt-4 text-4xl tracking-tight sm:text-5xl">Bago tumungo sa Luneta.</h2>
          </div>
          <div class="mt-10 divide-y divide-ink/15 border-y border-ink/15">
            {faqItems.map((item, index) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-left font-semibold text-ink marker:hidden">
                  <span><span class="mr-3 font-mono text-xs text-rizal-red">{String(index + 1).padStart(2, '0')}</span>{item.question}</span>
                  <span aria-hidden="true" class="text-xl font-light text-gold transition group-open:rotate-45">+</span>
                </summary>
                <p class="max-w-3xl pb-2 pl-9 pt-4 text-sm leading-7 text-ink-soft">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#091a29] py-10 text-white">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex flex-col justify-between gap-8 border-b border-white/10 pb-8 md:flex-row md:items-end">
          <img src="/logo.svg" width="300" height="50" alt="Motto Stella — Bantayog ni José Rizal" class="w-[280px] rounded-sm bg-paper px-3 py-2" />
          <div class="max-w-xl text-xs leading-6 text-white/50 md:text-right">
            <p>Mga pangunahing sanggunian: National Parks Development Committee (NPDC) at National Historical Commission of the Philippines (NHCP). Ang oras, access, transportasyon, at restaurant availability ay maaaring magbago.</p>
          </div>
        </div>
        <p class="pt-7 text-xs leading-6 text-white/55"><strong class="text-white/75">Hindi opisyal na website.</strong> Hindi ito pag-aari o pinapatakbo ng NPDC, NHCP, o Pamahalaan ng Pilipinas. Isa lamang itong independenteng gabay-pasyal; kumpirmahin ang pinakabagong advisory bago bumiyahe.</p>
      </div>
    </footer>
  </body>
</html>
