    <script is:inline define:vars={{ wxUrl: weatherApiUrl }}>
      (function () {
        var codes = {
          0: 'Maliwanag', 1: 'Halos maliwanag', 2: 'Bahagyang maulap', 3: 'Maulap',
          45: 'Makapal na hamog', 48: 'Makapal na hamog',
          51: 'Magaang ambon', 53: 'Ambon', 55: 'Makapal na ambon',
          56: 'Malamig na ambon', 57: 'Makapal na ambon',
          61: 'Magaang ulan', 63: 'Ulan', 65: 'Malakas na ulan',
          66: 'Malamig na ulan', 67: 'Malakas na ulan',
          80: 'Magaang pag-ulan', 81: 'Pag-ulan', 82: 'Malakas na pag-ulan',
          85: 'Pag-ulan', 86: 'Malakas na pag-ulan',
          95: 'Pagkulog at pagkidlat', 96: 'Kulog at malakas na ulan', 99: 'Kulog at malakas na ulan'
        };

        function codeText(code) {
          return codes[code] || 'Hindi tiyak ang lagay';
        }

        function setText(id, value) {
          var el = document.getElementById(id);
          if (el) el.textContent = value;
        }

        function weekdayStamp(iso) {
          var d = new Date(iso + 'T00:00:00+08:00');
          return d.toLocaleDateString('fil-PH', { timeZone: 'Asia/Manila', weekday: 'short' });
        }

        function dateStamp(iso) {
          var d = new Date(iso + 'T00:00:00+08:00');
          return d.toLocaleDateString('fil-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric' });
        }

        function renderDays(daily) {
          var host = document.getElementById('wx-days');
          if (!host || !daily || !daily.time) return;
          var html = '';
          for (var i = 0; i < daily.time.length; i++) {
            var pop = daily.precipitation_probability_max ? daily.precipitation_probability_max[i] : null;
            var need = pop !== null && pop >= 50;
            var rainLabel = (need ? 'Magdala ng payong' : 'Payong: opsyonal') + (pop !== null ? ' · ' + pop + '% ulan' : '');
            html += '<div class="bg-paper p-4">';
            html += '<p class="text-[10px] font-bold uppercase tracking-[.16em] text-rizal-red">' + weekdayStamp(daily.time[i]) + '</p>';
            html += '<p class="mt-1 text-[10px] text-ink-soft">' + dateStamp(daily.time[i]) + '</p>';
            html += '<p class="display mt-3 text-xl">' + Math.round(daily.temperature_2m_max[i]) + '° / ' + Math.round(daily.temperature_2m_min[i]) + '°</p>';
            html += '<p class="mt-2 text-xs leading-5 text-ink-soft">' + codeText(daily.weather_code[i]) + '</p>';
            html += '<p class="mt-2 text-[10px] font-semibold text-ink">' + rainLabel + '</p>';
            html += '</div>';
          }
          host.innerHTML = html;
        }

        fetch(wxUrl)
          .then(function (res) { return res.json(); })
          .then(function (data) {
            var cur = data && data.current;
            if (cur) {
              setText('wx-now-temp', Math.round(cur.temperature_2m));
              setText('wx-now-text', codeText(cur.weather_code));
              setText('wx-now-feels', Math.round(cur.apparent_temperature) + '°C');
              setText('wx-now-humidity', Math.round(cur.relative_humidity_2m) + '%');
              setText('wx-now-wind', Math.round(cur.wind_speed_10m) + ' km/h');
              setText('wx-now-rain', Number(cur.precipitation).toFixed(1) + ' mm');
            }
            renderDays(data && data.daily);
            var pop = data && data.daily && data.daily.precipitation_probability_max ? data.daily.precipitation_probability_max[0] : null;
            if (pop !== null) {
              setText('wx-advice', pop >= 50 ? 'Magdala ng payong — may ' + pop + '% na tsansa ng ulan ngayon.' : 'Mababa ang tsansa ng ulan (' + pop + '%). Payong ay opsyonal; tubig at lilim ang mahalaga.');
            }
            setText('wx-stamp', new Date().toLocaleString('fil-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium', timeStyle: 'short' }));
            var nodata = document.getElementById('wx-nodata');
            if (nodata) nodata.classList.add('hidden');
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
